{
  "schemaVersion": "1.0.0",
  "rules": [
    {
      "id": "private-key",
      "pattern": "-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----"
    },
    {
      "id": "github-token",
      "pattern": "\\b(gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{60,})\\b"
    },
    {
      "id": "aws-access-key",
      "pattern": "\\b(AKIA|ASIA)[A-Z0-9]{16}\\b"
    },
    {
      "id": "stripe-live-secret",
      "pattern": "\\b(sk|rk)_live_[A-Za-z0-9]{20,}\\b"
    },
    {
      "id": "slack-token",
      "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{20,}\\b"
    },
    {
      "id": "azure-storage-account-key",
      "pattern": "(?i)AccountKey\\s*=\\s*[A-Za-z0-9+/]{40,}={0,2}"
    },
    {
      "id": "azure-sas-token",
      "pattern": "(?i)(\\?|&)sig=[A-Za-z0-9%+/]{20,}={0,2}(&|$)"
    },
    {
      "id": "jwt",
      "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b"
    },
    {
      "id": "sendgrid-api-key",
      "pattern": "\\bSG\\.[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}\\b"
    },
    {
      "id": "google-api-key",
      "pattern": "\\bAIza[A-Za-z0-9_-]{30,}\\b"
    },
    {
      "id": "twilio-api-key",
      "pattern": "\\bSK[a-fA-F0-9]{32}\\b"
    },
    {
      "id": "database-connection-string",
      "pattern": "(?i)(Server|Data Source)\\s*=.*;(Password|Pwd)\\s*=\\s*[^;$\\s][^;]*"
    },
    {
      "id": "generic-secret-assignment",
      "pattern": "(?i)\\b(password|passwd|pwd|client[_-]?secret|api[_-]?key|access[_-]?token)\\b\\s*[:=]\\s*['\\\"][^'\\\"$]{12,}['\\\"]"
    }
  ],
  "entropy": {
    "minimumLength": 32,
    "threshold": 4.5
  },
  "hashBoundAllowlistManifests": [
    {
      "id": "approved-baseline-capture-binaries",
      "rootPath": "evidence/baseline",
      "manifestPath": "evidence/baseline/checksums.sha256",
      "manifestSha256": "f2d185ff4e18c859a9a5f14a78ce7765bee8935f56b129f002c8ea410d8abf06",
      "allowedCategories": [
        "known-binary"
      ],
      "allowedPathPatterns": [
        "^evidence/baseline/assets/",
        "^evidence/baseline/screenshots/"
      ]
    }
  ],
  "sourceArchiveExtensions": [
    ".7z",
    ".docx",
    ".gz",
    ".tar",
    ".xlsx",
    ".zip"
  ],
  "knownBinaryExtensions": [
    ".7z",
    ".avi",
    ".bmp",
    ".dll",
    ".doc",
    ".docx",
    ".exe",
    ".gif",
    ".gz",
    ".ico",
    ".jpeg",
    ".jpg",
    ".mov",
    ".mp3",
    ".mp4",
    ".pdf",
    ".png",
    ".pdb",
    ".so",
    ".tar",
    ".tiff",
    ".webp",
    ".woff",
    ".woff2",
    ".xls",
    ".xlsx",
    ".zip"
  ],
  "excludedPathPatterns": [
    "(^|/)\\.git(/|$)",
    "(^|/)(bin|obj)(/|$)",
    "(^|/)artifacts(/|$)",
    "(^|/)\\.validation-output(/|$)"
  ]
}
