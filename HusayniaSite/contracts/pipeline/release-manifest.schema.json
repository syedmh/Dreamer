{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.husaynia.org/pipeline/release-manifest.schema.json",
  "title": "Husaynia immutable release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "commitSha",
    "builtAtUtc",
    "dotnetSdk",
    "files",
    "databaseCompatibility",
    "requiredConfigurationKeys",
    "prohibitedLiveConfigurationInNonProduction"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "builtAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "dotnetSdk": {
      "type": "string",
      "pattern": "^10\\."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "length"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "length": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "databaseCompatibility": {
      "type": "string",
      "minLength": 1
    },
    "requiredConfigurationKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prohibitedLiveConfigurationInNonProduction": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$comment": "Artifact name is husaynia-site-{version}. The same application archive SHA-256 is promoted through Development, Staging, and separately authorized Production without rebuilding."
}
