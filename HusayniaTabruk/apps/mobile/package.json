{
  "name": "tabruk-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "generate:api": "node ./src/core/api/generate-api-client.mjs",
    "check:generated-client": "node ./src/core/api/generate-api-client.mjs --check",
    "lint": "eslint --config node_modules/eslint-config-expo/flat.js app src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.10",
    "expo": "57.0.13",
    "expo-constants": "57.0.11",
    "expo-linking": "57.0.6",
    "expo-router": "57.0.13",
    "expo-secure-store": "file:vendor/expo-secure-store-57.0.1.tgz",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.4",
    "typescript": "6.0.3"
  }
}
