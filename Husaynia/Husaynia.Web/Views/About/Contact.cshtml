@{
    ViewData["Title"] = "Contact Us";
    ViewData["Description"] = "Get in touch with Husaynia Islamic Society";
}

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4" style="color: #b90000; font-weight: 600;">Contact Us</h1>
            <p class="mb-4">We'd love to hear from you</p>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row mb-5">
                <div class="col-lg-6 mb-4">
                    <div class="contact-section p-4 bg-white border h-100">
                        <h4 class="mb-4" style="color: #b90000;"><i class="fas fa-paper-plane"></i> Send Us a Message</h4>
                        <form asp-action="SubmitContact" method="post">
                            <div class="mb-3">
                                <label for="name" class="form-label">Name *</label>
                                <input type="text" class="form-control" id="name" name="name" required>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">Email *</label>
                                <input type="email" class="form-control" id="email" name="email" required>
                            </div>

                            <div class="mb-3">
                                <label for="subject" class="form-label">Subject</label>
                                <input type="text" class="form-control" id="subject" name="subject">
                            </div>

                            <div class="mb-3">
                                <label for="message" class="form-label">Message *</label>
                                <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn" style="background-color: #b90000; color: white;">
                                    <i class="fas fa-paper-plane"></i> Send Message
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="contact-section p-4 bg-white border mb-3">
                        <h5 style="color: #b90000;"><i class="fas fa-map-marker-alt"></i> Address</h5>
                        <p>
                            15231 State St<br />
                            Snohomish, WA 98296
                        </p>
                        <a href="https://maps.google.com/?q=15231+State+St,+Snohomish,+WA" target="_blank" class="btn btn-sm" style="background-color: #b90000; color: white;">
                            <i class="fas fa-directions"></i> Get Directions
                        </a>
                    </div>

                    <div class="contact-section p-4 bg-white border mb-3">
                        <h5 style="color: #b90000;"><i class="fas fa-phone"></i> Phone</h5>
                        <p>
                            <a href="tel:+14253123196" style="color: #b90000;">+1-425-312-3196</a>
                        </p>
                    </div>

                    <div class="contact-section p-4 bg-white border mb-3">
                        <h5 style="color: #b90000;"><i class="fas fa-envelope"></i> Email</h5>
                        <p>
                            <a href="mailto:info@husaynia.org" style="color: #b90000;">info@husaynia.org</a>
                        </p>
                    </div>

                    <div class="contact-section p-4 bg-white border">
                        <h5 style="color: #b90000;"><i class="fas fa-share-alt"></i> Social Media</h5>
                        <div class="d-flex gap-2">
                            <a href="https://www.facebook.com/husayniais" target="_blank" class="btn btn-sm" style="background-color: #b90000; color: white;">
                                <i class="fab fa-facebook-f"></i> Facebook
                            </a>
                            <a href="https://www.instagram.com/husayniais" target="_blank" class="btn btn-sm" style="background-color: #b90000; color: white;">
                                <i class="fab fa-instagram"></i> Instagram
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Google Maps -->
            <div class="map-section p-4 bg-white border">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2677.9!2d-122.0982!3d47.9129!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDfCsDU0JzQ2LjQiTiAxMjLCsDA1JzUzLjUiVw!5e0!3m2!1sen!2sus!4v1234567890"
                    width="100%"
                    height="400"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>
    </div>
</div>

<style>
    .contact-section, .map-section {
        border-left: 4px solid #b90000 !important;
    }
</style>
