@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Configuration["SiteSettings:SiteName"]</title>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="Husaynia, Islamic Society, Seattle, Shia Muslim, Mosque, Prayer Times, Events, Community" />
    <meta name="author" content="Husaynia Islamic Society" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="og:title" content="@ViewData["Title"] - @Configuration["SiteSettings:SiteName"]" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/images/og-image.jpg")" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="twitter:title" content="@ViewData["Title"] - @Configuration["SiteSettings:SiteName"]" />
    <meta property="twitter:description" content="@ViewData["Description"]" />
    <meta property="twitter:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/images/og-image.jpg")" />

    <link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Bar -->
    <div class="top-bar">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="top-info">
                        <span class="date-info">
                            <i class="far fa-calendar"></i>
                            @DateTime.Now.ToString("MMMM dd, yyyy") |
                            <span style="color: #B90000;">Islamic Date: @GetIslamicDate()</span>
                        </span>
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <div class="top-links">
                        <a href="@Configuration["SiteSettings:FacebookPageUrl"]" target="_blank" title="Facebook"><i class="fab fa-facebook"></i></a>
                        <a href="@Configuration["SiteSettings:YouTubeChannelUrl"]" target="_blank" title="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="https://wa.me/14253123196" target="_blank" title="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                        <form class="d-inline-block ms-3" asp-controller="Search" asp-action="Index" method="get" style="display: inline-block;">
                            <div class="search-box-top">
                                <input type="search" name="q" placeholder="Search..." class="search-input-top">
                                <button type="submit" class="search-btn-top"><i class="fas fa-search"></i></button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

@functions {
    string GetIslamicDate()
    {
        // Simple Islamic date approximation - you may want to use a proper library
        var gregorianDate = DateTime.Now;
        // Basic conversion (this is approximate - use proper Islamic calendar library for accuracy)
        var islamicYear = 1445; // Update this based on current Islamic year
        var islamicMonth = "Rajab"; // Update based on current month
        var islamicDay = gregorianDate.Day;
        return $"{islamicMonth} {islamicDay}, {islamicYear}";
    }
}

    <!-- Main Header -->
    <header class="main-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-2">
                    <div class="logo">
                        <a asp-controller="Home" asp-action="Index">
                            <img src="~/images/logo.png" alt="@Configuration["SiteSettings:SiteName"]" style="height: 80px; width: auto;" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                            <h3 style="display: none; color: #B90000; margin: 0;">Husaynia</h3>
                        </a>
                    </div>
                </div>
                <div class="col-md-10">
                    <nav class="navbar navbar-expand-lg navbar-light">
                        <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                                aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="mainNavbar">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link btn btn-donate" asp-controller="Donations" asp-action="Donate">
                                        <i class="fas fa-heart"></i> Donate
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Announcements" asp-action="Index">Announcements</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="supplicationsDropdown" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        Supplications
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="supplicationsDropdown">
                                        <li><a class="dropdown-item" asp-controller="About" asp-action="Duas">Duas</a></li>
                                        <li><a class="dropdown-item" asp-controller="About" asp-action="HadithAlKisa">Hadith Al Kisa</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Donations" asp-action="BuildHusaynia">Build Husaynia</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="calendarDropdown" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        Calendar
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="calendarDropdown">
                                        <li><a class="dropdown-item" asp-controller="Calendar" asp-action="PrayerTimings">Prayer Timings</a></li>
                                        <li><a class="dropdown-item" asp-controller="Calendar" asp-action="IslamicCalendar">Islamic Calendar</a></li>
                                        <li><a class="dropdown-item" asp-controller="Calendar" asp-action="UpcomingPrograms">Upcoming Programs</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="mediaDropdown" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        Media
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="mediaDropdown">
                                        <li><a class="dropdown-item" asp-controller="Media" asp-action="Photos">Photos</a></li>
                                        <li><a class="dropdown-item" asp-controller="Media" asp-action="Videos">Videos</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="aboutDropdown" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        About Us
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="aboutDropdown">
                                        <li><a class="dropdown-item" asp-controller="About" asp-action="Overview">Overview</a></li>
                                        <li><a class="dropdown-item" asp-controller="About" asp-action="Contact">Contact Us</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </nav>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5>@Configuration["SiteSettings:SiteName"]</h5>
                    <p>A community center dedicated to serving the Muslim community in the Seattle area.</p>
                    <div class="social-links mt-3">
                        <a href="@Configuration["SiteSettings:FacebookPageUrl"]" target="_blank"><i class="fab fa-facebook fa-lg"></i></a>
                        <a href="@Configuration["SiteSettings:YouTubeChannelUrl"]" target="_blank"><i class="fab fa-youtube fa-lg"></i></a>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Quick Links</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Announcements" asp-action="Index">Announcements</a></li>
                        <li><a asp-controller="Calendar" asp-action="UpcomingPrograms">Events</a></li>
                        <li><a asp-controller="About" asp-action="Contact">Contact Us</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Contact Info</h5>
                    <ul class="footer-contact">
                        <li><i class="fas fa-map-marker-alt"></i> @Configuration["SiteSettings:Address"]</li>
                        <li><i class="fas fa-phone"></i> @Configuration["SiteSettings:ContactPhone"]</li>
                        <li><i class="fas fa-envelope"></i> @Configuration["SiteSettings:ContactEmail"]</li>
                    </ul>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-12 text-center">
                    <p class="mb-0">&copy; @DateTime.Now.Year @Configuration["SiteSettings:SiteName"]. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
