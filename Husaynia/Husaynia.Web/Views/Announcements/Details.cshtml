@model Husaynia.Core.Entities.Announcement
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Excerpt;
}

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" style="color: #b90000;">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Announcements" asp-action="Index" style="color: #b90000;">Announcements</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                </ol>
            </nav>

            <!-- Announcement Content -->
            <article class="announcement-detail p-4 bg-white border">
                @if (Model.IsPinned)
                {
                    <span class="badge mb-3" style="background-color: #b90000;">
                        <i class="fas fa-thumbtack"></i> Featured
                    </span>
                }

                <h1 class="mb-3" style="color: #b90000; font-weight: 600;">@Model.Title</h1>

                <p class="text-muted small mb-4">
                    <i class="far fa-calendar"></i> @Model.PublishedDate.ToString("MMMM dd, yyyy") |
                    <i class="far fa-user"></i> @Model.Author |
                    <i class="far fa-eye"></i> @Model.ViewCount views
                </p>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="announcement-image mb-4">
                        <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid" />
                    </div>
                }

                <div class="announcement-content">
                    @Html.Raw(Model.Content)
                </div>

                @if (!string.IsNullOrEmpty(Model.Tags))
                {
                    <div class="announcement-tags mt-4 pt-3 border-top">
                        <strong><i class="fas fa-tags"></i> Tags:</strong>
                        @foreach (var tag in Model.Tags.Split(','))
                        {
                            <span class="badge bg-secondary me-1">@tag.Trim()</span>
                        }
                    </div>
                }

                <!-- Back Button -->
                <div class="mt-4">
                    <a asp-action="Index" class="btn btn-sm" style="background-color: #b90000; color: white;">
                        <i class="fas fa-arrow-left"></i> Back to Announcements
                    </a>
                </div>
            </article>
        </div>
    </div>
</div>

<style>
    .announcement-detail {
        border-left: 4px solid #b90000 !important;
    }

    .announcement-content {
        font-size: 1.05rem;
        line-height: 1.7;
    }

    .announcement-content h2 {
        margin-top: 2rem;
        margin-bottom: 1rem;
        color: #333;
    }

    .announcement-content p {
        margin-bottom: 1.2rem;
    }

    .announcement-content img {
        max-width: 100%;
        height: auto;
        margin: 1.5rem 0;
    }
</style>
