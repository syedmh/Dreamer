@model List<Husaynia.Core.Entities.MediaItem>
@{
    ViewData["Title"] = "Video Gallery";
    ViewData["Description"] = "Watch videos from our programs and events";
}

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4" style="color: #b90000; font-weight: 600;">Video Gallery</h1>
            <p class="mb-4">Watch videos from our lectures, programs, and events</p>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No videos available yet. Check back soon!
                </div>
            }
            else
            {
                <div class="video-gallery-section p-4 bg-white border">
                    <div class="row g-4">
                        @foreach (var video in Model)
                        {
                            <div class="col-lg-4 col-md-6">
                                <div class="video-card">
                                    <div class="video-embed-container">
                                        @if (!string.IsNullOrEmpty(video.ThumbnailUrl))
                                        {
                                            <div class="video-thumbnail" data-video-url="@video.Url">
                                                <img src="@video.ThumbnailUrl" alt="@video.Title" class="img-fluid">
                                                <div class="play-button">
                                                    <i class="fas fa-play-circle"></i>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <iframe src="@video.Url"
                                                    frameborder="0"
                                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                                    allowfullscreen
                                                    loading="lazy">
                                            </iframe>
                                        }
                                    </div>
                                    <div class="mt-3">
                                        <h5 style="color: #333; font-size: 1.1rem;">@video.Title</h5>
                                        @if (!string.IsNullOrEmpty(video.Description))
                                        {
                                            <p class="text-muted small mb-2">@video.Description</p>
                                        }
                                        <p class="text-muted small mb-0">
                                            <i class="far fa-calendar"></i> @video.UploadDate.ToString("MMMM dd, yyyy")
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Lazy load videos on thumbnail click
        document.querySelectorAll('.video-thumbnail').forEach(thumbnail => {
            thumbnail.addEventListener('click', function() {
                const videoUrl = this.dataset.videoUrl;
                const iframe = document.createElement('iframe');
                iframe.src = videoUrl + '?autoplay=1';
                iframe.frameBorder = '0';
                iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
                iframe.allowFullscreen = true;

                this.parentElement.innerHTML = '';
                this.parentElement.appendChild(iframe);
            });
        });
    </script>
}

<style>
    .video-gallery-section {
        border-left: 4px solid #b90000 !important;
    }

    .video-card {
        margin-bottom: 1rem;
    }

    .video-embed-container {
        position: relative;
        padding-bottom: 56.25%; /* 16:9 aspect ratio */
        height: 0;
        overflow: hidden;
        background: #000;
    }

    .video-embed-container iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .video-thumbnail {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        cursor: pointer;
    }

    .video-thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .play-button {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 4rem;
        color: white;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
        transition: transform 0.3s ease;
    }

    .video-thumbnail:hover .play-button {
        transform: translate(-50%, -50%) scale(1.1);
    }
</style>
