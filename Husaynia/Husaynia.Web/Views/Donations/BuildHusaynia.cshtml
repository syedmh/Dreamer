@{
    ViewData["Title"] = "Build Husaynia";
    ViewData["Description"] = "Support the construction of a permanent home for Husaynia Islamic Society";
    var campaign = ViewBag.Campaign as Husaynia.Core.Entities.DonationCampaign;
    var recentDonations = ViewBag.RecentDonations as List<Husaynia.Core.Entities.Donation>;
    var progressPercentage = campaign != null ? (campaign.CurrentAmount / campaign.GoalAmount * 100) : 0;
}

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <!-- Hero Section -->
            <div class="mb-5 text-center">
                <h1 class="mb-3" style="color: #b90000; font-weight: 600;">Build Husaynia</h1>
                <p class="mb-4">Help us build a permanent home for our growing community</p>
            </div>

            <!-- Campaign Progress Card -->
            <div class="campaign-progress-section mb-5 p-4 bg-white border">
                <div class="text-center mb-4">
                    <h2 class="mb-4" style="color: #b90000;">Campaign Progress</h2>
                    <div class="mb-2" style="font-size: 3rem; font-weight: 600; color: #b90000;">
                        $@(campaign?.CurrentAmount.ToString("N0") ?? "2,961,788")
                    </div>
                    <p class="text-muted">raised of $@(campaign?.GoalAmount.ToString("N0") ?? "6,950,000") goal</p>
                </div>

                <div class="progress mb-4" style="height: 40px;">
                    <div class="progress-bar"
                         role="progressbar"
                         style="width: @progressPercentage%; background-color: #b90000;"
                         aria-valuenow="@(campaign?.CurrentAmount ?? 0)"
                         aria-valuemin="0"
                         aria-valuemax="@(campaign?.GoalAmount ?? 0)">
                        <strong>@progressPercentage.ToString("F1")%</strong>
                    </div>
                </div>

                <div class="text-center">
                    <a asp-action="Donate" class="btn btn-lg" style="background-color: #b90000; color: white;">
                        <i class="fas fa-heart"></i> Donate Now
                    </a>
                </div>
            </div>

            <!-- Project Information -->
            <h2 class="mb-4" style="color: #333;">About the Project</h2>
            <section class="project-section mb-4 p-4 bg-white border">
                <h4 class="mb-3" style="color: #b90000;"><i class="fas fa-mosque"></i> Our Vision</h4>
                    <p>
                        Husaynia Islamic Society of Seattle aims to establish a permanent, dedicated space
                        to serve the growing Shia Muslim community in the greater Seattle area. This project
                        will provide a center for worship, education, social services, and community gatherings.
                    </p>
            </section>

            <section class="project-section mb-4 p-4 bg-white border">
                <h4 class="mb-3" style="color: #b90000;"><i class="fas fa-building"></i> What We're Building</h4>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-check text-success"></i> Prayer hall accommodating 500+ worshippers</li>
                        <li class="mb-2"><i class="fas fa-check text-success"></i> Separate prayer areas for men and women</li>
                        <li class="mb-2"><i class="fas fa-check text-success"></i> Educational classrooms for children and adults</li>
                        <li class="mb-2"><i class="fas fa-check text-success"></i> Library and resource center</li>
                        <li class="mb-2"><i class="fas fa-check text-success"></i> Commercial kitchen for community events</li>
                        <li class="mb-2"><i class="fas fa-check text-success"></i> Multi-purpose hall for gatherings</li>
                        <li class="mb-2"><i class="fas fa-check text-success"></i> Parking and accessibility features</li>
                    </ul>
            </section>

            <section class="project-section mb-4 p-4 bg-white border">
                <h4 class="mb-3" style="color: #b90000;"><i class="fas fa-hand-holding-usd"></i> How You Can Help</h4>
                    <p>
                        Every contribution, large or small, brings us closer to our goal. Your donation will
                        directly support the construction and establishment of this vital community center.
                    </p>
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> <strong>Tax-Deductible:</strong> All donations are tax-deductible.
                    Husaynia Islamic Society is a registered 501(c)(3) nonprofit organization.
                </div>
            </section>

            <!-- Recent Donors -->
            @if (recentDonations != null && recentDonations.Any())
            {
                <h2 class="mb-4" style="color: #333;">Recent Donors</h2>
                <section class="donors-section mb-5 p-4 bg-white border">
                    <ul class="list-group list-group-flush">
                        @foreach (var donation in recentDonations.Take(10))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@donation.DonorName</strong>
                                    <small class="text-muted d-block">@donation.DonationDate.ToString("MMMM dd, yyyy")</small>
                                </div>
                                <span class="badge rounded-pill" style="background-color: #b90000;">$@donation.Amount.ToString("N0")</span>
                            </li>
                        }
                    </ul>
                </section>
            }

            <!-- Call to Action -->
            <section class="cta-section p-5 text-center text-white" style="background-color: #b90000;">
                <h3 class="mb-3">Join Us in Building Our Community</h3>
                <p class="lead mb-4">
                    "The example of those who spend their wealth in the way of Allah is like a seed
                    which grows seven spikes, in each spike is a hundred grains." - Quran 2:261
                </p>
                <a asp-action="Donate" class="btn btn-light btn-lg">
                    <i class="fas fa-heart"></i> Make Your Donation Today
                </a>
            </section>
        </div>
    </div>
</div>

<style>
    .campaign-progress-section, .project-section, .donors-section {
        border-left: 4px solid #b90000 !important;
    }
</style>
