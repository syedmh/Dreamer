@page
@model AnnouncementsIndexModel
@{
    ViewData["Title"] = "Manage Announcements";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-bullhorn"></i> Announcements</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> New Announcement
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Published Date</th>
                        <th>Pinned</th>
                        <th>Views</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var announcement in Model.Announcements)
                    {
                        <tr>
                            <td>
                                @announcement.Title
                                @if (announcement.IsPinned)
                                {
                                    <span class="badge bg-danger">Pinned</span>
                                }
                            </td>
                            <td>@announcement.Author</td>
                            <td>@announcement.PublishedDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (announcement.IsPinned)
                                {
                                    <i class="fas fa-check text-success"></i>
                                }
                                else
                                {
                                    <i class="fas fa-times text-muted"></i>
                                }
                            </td>
                            <td>@announcement.ViewCount</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-page="Edit" asp-route-id="@announcement.Id" class="btn btn-outline-primary">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" onclick="confirmDelete(@announcement.Id)">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Announcements.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-bullhorn fa-3x text-muted mb-3"></i>
                <p class="text-muted">No announcements yet. Create your first announcement!</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            if (confirm('Are you sure you want to delete this announcement?')) {
                fetch(`/Admin/Announcements/Delete/${id}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                }).then(() => {
                    location.reload();
                });
            }
        }
    </script>
}
