// PRODUCTION SCHEMA — Azure SQL Server
// To switch to production:
//   1. Copy this file over prisma/schema.prisma
//   2. Set DATABASE_URL to your Azure SQL connection string
//   3. Run: npx prisma migrate deploy
//
// Or use the npm script: npm run db:use-sqlserver

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Event {
  id            String   @id @default(uuid())
  name          String
  date          DateTime
  location      String
  address       String?
  price         Int      @default(5000)
  active        Boolean  @default(true)
  description   String?  @db.NVarChar(Max)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  registrations Registration[]
}

model Registration {
  id        String  @id @default(uuid())
  status    String  @default("DRAFT")
  eventId   String?
  event     Event?  @relation(fields: [eventId], references: [id])

  firstName       String
  middleName      String?
  lastName        String
  preferredName   String?
  dateOfBirth     DateTime
  gender          String
  phone           String
  email           String   @unique
  city            String
  state           String
  countryOfOrigin String?
  languages       String
  howDidYouHear   String?

  practicingMuslim    String?
  sect                String?
  prayerFrequency     String?
  fastingRamadan      String?
  attendsMajalis      String?
  hijabStatus         String?
  religiousKnowledge  String?
  performedHajj       String?
  performedZiyarat    String?
  ziyaratLocations    String?
  marja               String?
  religionImportance  Int?       @default(5)

  educationLevel  String?
  fieldOfStudy    String?
  university      String?
  occupation      String?
  employer        String?
  incomeRange     String?
  careerGoals     String?  @db.NVarChar(Max)

  maritalStatus       String?
  hasChildren         Boolean? @default(false)
  numberOfChildren    Int?     @default(0)
  height              String?
  bodyType            String?
  smokingStatus       String?
  healthConditions    String?  @db.NVarChar(Max)
  livingSituation     String?
  willingToRelocate   String?
  pets                String?
  hobbies             String?
  selfDescription     String?  @db.NVarChar(Max)

  fatherName          String?
  fatherAlive         Boolean? @default(true)
  motherAlive         Boolean? @default(true)
  numberOfSiblings    Int?     @default(0)
  familyOrigin        String?
  familySupportive    String?
  familyReligiosity   String?
  familyExpectations  String?  @db.NVarChar(Max)

  prefAgeMin          Int?
  prefAgeMax          Int?
  prefHeightMin       String?
  prefHeightMax       String?
  prefEthnicity       String?
  prefEducation       String?
  prefIncome          String?
  prefLocation        String?
  prefMaritalStatus   String?
  prefChildren        String?
  prefReligiosity     String?
  dealBreakers        String?  @db.NVarChar(Max)
  lookingForInSpouse  String?  @db.NVarChar(Max)
  additionalNotes     String?  @db.NVarChar(Max)

  waliName            String?
  waliPhone           String?
  waliEmail           String?
  waliRelationship    String?
  emergencyName       String?
  emergencyPhone      String?
  emergencyRelation   String?
  agreedTerms         Boolean  @default(false)
  agreedPrivacy       Boolean  @default(false)
  confirmedTruthful   Boolean  @default(false)
  agreedNonRefundable Boolean  @default(false)
  agreedInfoSharing   Boolean  @default(false)
  digitalSignature    String?

  stripeCustomerId    String?
  stripeSessionId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profilePhoto  ProfilePhoto?
  payments      PaymentRecord[]
  matchNotes    MatchNote[]

  @@index([gender])
  @@index([city, state])
  @@index([maritalStatus])
  @@index([status])
  @@index([dateOfBirth])
}

model ProfilePhoto {
  id              String       @id @default(uuid())
  registrationId  String       @unique
  registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  blobUrl         String
  thumbnailUrl    String?
  originalFilename String
  mimeType        String
  sizeBytes       Int
  createdAt       DateTime     @default(now())
}

model PaymentRecord {
  id              String       @id @default(uuid())
  registrationId  String
  registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  stripeSessionId String?
  paymentIntentId String?
  amount          Int
  currency        String       @default("usd")
  status          String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([stripeSessionId])
  @@index([paymentIntentId])
}

model AdminUser {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("admin")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  matchNotes    MatchNote[]
}

model MatchNote {
  id              String       @id @default(uuid())
  registrationId  String
  registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  note            String       @db.NVarChar(Max)
  createdById     String
  createdBy       AdminUser    @relation(fields: [createdById], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}
