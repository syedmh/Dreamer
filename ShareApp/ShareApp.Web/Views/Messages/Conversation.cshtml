@model ShareApp.Web.Models.ViewModels.ConversationDetailsViewModel

@{
    ViewData["Title"] = $"Conversation with {Model.OtherUserName}";
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Messages</a></li>
            <li class="breadcrumb-item active">@Model.OtherUserName</li>
        </ol>
    </nav>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-user-circle"></i> @Model.OtherUserName
                </h5>
                @if (!string.IsNullOrEmpty(Model.ItemTitle))
                {
                    <span class="badge bg-light text-dark">
                        <i class="fas fa-box"></i> @Model.ItemTitle
                    </span>
                }
            </div>
        </div>
        <div class="card-body" style="height: 500px; overflow-y: auto;" id="messagesContainer">
            @if (!Model.Messages.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="fas fa-comments fa-3x mb-3"></i>
                    <p>No messages yet. Start the conversation below!</p>
                </div>
            }
            else
            {
                @foreach (var message in Model.Messages)
                {
                    <div class="message-item mb-3 @(message.IsSent ? "text-end" : "")">
                        <div class="d-inline-block" style="max-width: 70%;">
                            @if (!message.IsSent)
                            {
                                <small class="text-muted d-block mb-1">
                                    <i class="fas fa-user"></i> @message.SenderName
                                </small>
                            }
                            <div class="message-bubble @(message.IsSent ? "bg-primary text-white" : "bg-light") p-3 rounded">
                                <p class="mb-0">@message.Content</p>
                            </div>
                            <small class="text-muted d-block mt-1">
                                @message.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
                                @if (message.IsSent && message.IsRead && message.ReadAt.HasValue)
                                {
                                    <i class="fas fa-check-double text-primary"></i>
                                    <span class="ms-1">Read</span>
                                }
                                else if (message.IsSent)
                                {
                                    <i class="fas fa-check"></i>
                                    <span class="ms-1">Sent</span>
                                }
                            </small>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="card-footer">
            <form asp-action="Send" method="post">
                <input type="hidden" asp-for="SendMessage.ReceiverId" />
                <input type="hidden" asp-for="SendMessage.ItemId" />

                <div class="input-group">
                    <textarea asp-for="SendMessage.Content" class="form-control" rows="2"
                              placeholder="Type your message..." required></textarea>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane"></i> Send
                    </button>
                </div>
                <span asp-validation-for="SendMessage.Content" class="text-danger small"></span>
            </form>
        </div>
    </div>

    @if (Model.ItemId.HasValue)
    {
        <div class="mt-3">
            <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.ItemId" class="btn btn-outline-primary">
                <i class="fas fa-box"></i> View Item: @Model.ItemTitle
            </a>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Auto-scroll to bottom of messages
        $(document).ready(function() {
            var container = document.getElementById('messagesContainer');
            if (container) {
                container.scrollTop = container.scrollHeight;
            }
        });

        // Auto-resize textarea
        $('textarea').on('input', function() {
            this.style.height = 'auto';
            this.style.height = (this.scrollHeight) + 'px';
        });
    </script>

    <style>
        .message-bubble {
            word-wrap: break-word;
            white-space: pre-wrap;
        }

        #messagesContainer {
            scroll-behavior: smooth;
        }
    </style>
}
