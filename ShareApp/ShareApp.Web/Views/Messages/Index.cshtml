@model ShareApp.Web.Models.ViewModels.MessagesInboxViewModel

@{
    ViewData["Title"] = "Messages";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-envelope"></i> Messages
            @if (Model.TotalUnread > 0)
            {
                <span class="badge bg-danger">@Model.TotalUnread</span>
            }
        </h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Conversations.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-comments fa-3x mb-3"></i>
            <h4>No Messages Yet</h4>
            <p>Start a conversation by messaging a seller from an item page.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                <i class="fas fa-search"></i> Browse Items
            </a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="list-group list-group-flush">
                @foreach (var conversation in Model.Conversations)
                {
                    <a asp-action="Conversation" asp-route-id="@conversation.OtherUserId" asp-route-itemId="@conversation.ItemId"
                       class="list-group-item list-group-item-action @(conversation.UnreadCount > 0 ? "bg-light" : "")">
                        <div class="d-flex w-100 justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fas fa-user-circle fa-2x text-primary me-2"></i>
                                    <div>
                                        <h6 class="mb-0">
                                            @conversation.OtherUserName
                                            @if (conversation.UnreadCount > 0)
                                            {
                                                <span class="badge bg-danger ms-2">@conversation.UnreadCount new</span>
                                            }
                                        </h6>
                                        @if (!string.IsNullOrEmpty(conversation.ItemTitle))
                                        {
                                            <small class="text-muted">
                                                <i class="fas fa-box"></i> @conversation.ItemTitle
                                            </small>
                                        }
                                    </div>
                                </div>
                                <p class="mb-1 text-muted">@conversation.LastMessagePreview</p>
                            </div>
                            <small class="text-muted text-nowrap ms-3">
                                @if (conversation.LastMessageDate.HasValue)
                                {
                                    @conversation.LastMessageDate.Value.ToString("MMM dd, hh:mm tt")
                                }
                            </small>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</div>
