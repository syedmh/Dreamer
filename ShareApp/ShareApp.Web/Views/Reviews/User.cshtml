@model ShareApp.Web.Models.ViewModels.UserReviewsViewModel

@{
    ViewData["Title"] = $"Reviews for {Model.UserName}";
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active">User Reviews</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-user-circle fa-5x text-primary"></i>
                    </div>
                    <h4 class="mb-2">@Model.UserName</h4>

                    @if (Model.AverageRating.HasValue && Model.TotalReviews > 0)
                    {
                        <div class="mb-3">
                            <div class="h2 mb-1">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Floor((double)Model.AverageRating.Value))
                                    {
                                        <i class="fas fa-star text-warning"></i>
                                    }
                                    else if (i - 0.5 <= (double)Model.AverageRating.Value)
                                    {
                                        <i class="fas fa-star-half-alt text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star text-warning"></i>
                                    }
                                }
                            </div>
                            <p class="mb-0">
                                <strong>@Model.AverageRating.Value.ToString("F1")</strong> out of 5
                            </p>
                            <p class="text-muted small mb-0">
                                Based on @Model.TotalReviews review@(Model.TotalReviews != 1 ? "s" : "")
                            </p>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No reviews yet</p>
                    }

                    <hr />

                    <div class="text-start">
                        <p class="mb-2">
                            <i class="fas fa-box text-muted"></i>
                            <strong>Member since:</strong> Recently joined
                        </p>
                        <p class="mb-0">
                            <i class="fas fa-exchange-alt text-muted"></i>
                            <strong>Transactions:</strong> @Model.TotalReviews
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-comments"></i> Reviews (@Model.TotalReviews)
                    </h5>
                </div>
                <div class="card-body">
                    @if (!Model.Reviews.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-comment-slash fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No reviews yet. Be the first to complete a transaction with this user!</p>
                        </div>
                    }
                    else
                    {
                        <div class="reviews-list">
                            @foreach (var review in Model.Reviews)
                            {
                                <div class="review-item mb-4 pb-4 border-bottom">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="mb-1">
                                                <i class="fas fa-user"></i> @review.ReviewerName
                                            </h6>
                                            <div class="mb-1">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= review.Rating)
                                                    {
                                                        <i class="fas fa-star text-warning"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-star text-warning"></i>
                                                    }
                                                }
                                                <span class="ms-2 text-muted small">@review.Rating out of 5</span>
                                            </div>
                                        </div>
                                        <small class="text-muted">
                                            @review.CreatedAt.ToString("MMM dd, yyyy")
                                        </small>
                                    </div>

                                    <p class="mb-2 text-muted small">
                                        <i class="fas fa-box"></i> Transaction for: <strong>@review.ItemTitle</strong>
                                    </p>

                                    @if (!string.IsNullOrEmpty(review.Comment))
                                    {
                                        <p class="mb-0 text-break">@review.Comment</p>
                                    }
                                    else
                                    {
                                        <p class="mb-0 text-muted fst-italic">No comment provided</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .review-item:last-child {
        border-bottom: none !important;
        margin-bottom: 0 !important;
        padding-bottom: 0 !important;
    }
</style>
