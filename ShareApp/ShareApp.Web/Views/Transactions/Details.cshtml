@model ShareApp.Web.Models.ViewModels.TransactionDetailsViewModel

@{
    ViewData["Title"] = "Transaction Details";
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Transactions</a></li>
            <li class="breadcrumb-item active">Details</li>
        </ol>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-@(Model.Status == ShareApp.Web.Entities.TransactionStatus.Completed ? "success" : Model.Status == ShareApp.Web.Entities.TransactionStatus.Pending ? "warning" : "secondary") text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-exchange-alt"></i> Transaction #@Model.Id
                        <span class="float-end badge bg-light text-dark">@Model.Status</span>
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Item Information -->
                    <div class="mb-4">
                        <h5><i class="fas fa-box"></i> Item Details</h5>
                        <div class="row">
                            <div class="col-md-4">
                                @if (!string.IsNullOrEmpty(Model.ItemImageUrl))
                                {
                                    <img src="@Model.ItemImageUrl" class="img-fluid rounded" alt="@Model.ItemTitle" />
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 150px;">
                                        <i class="fas fa-image fa-3x text-muted"></i>
                                    </div>
                                }
                            </div>
                            <div class="col-md-8">
                                <h6 class="mb-2">@Model.ItemTitle</h6>
                                <p class="text-muted">@Model.ItemDescription</p>
                                <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.ItemId" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i> View Item
                                </a>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Transaction Details -->
                    <div class="mb-4">
                        <h5><i class="fas fa-info-circle"></i> Transaction Information</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-2">
                                    <strong>Type:</strong>
                                    @if (Model.TransactionType == ShareApp.Web.Entities.TransactionType.Purchase)
                                    {
                                        <span class="badge bg-success">Purchase</span>
                                    }
                                    else if (Model.TransactionType == ShareApp.Web.Entities.TransactionType.FreePickup)
                                    {
                                        <span class="badge bg-primary">Free Pickup</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">Barter</span>
                                    }
                                </p>
                                @if (Model.Amount.HasValue)
                                {
                                    <p class="mb-2">
                                        <strong>Amount:</strong>
                                        <span class="text-success">$@Model.Amount.Value.ToString("F2")</span>
                                    </p>
                                }
                                <p class="mb-2">
                                    <strong>Created:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
                                </p>
                                @if (Model.CompletedAt.HasValue)
                                {
                                    <p class="mb-2">
                                        <strong>Completed:</strong> @Model.CompletedAt.Value.ToString("MMM dd, yyyy hh:mm tt")
                                    </p>
                                }
                                @if (Model.CancelledAt.HasValue)
                                {
                                    <p class="mb-2">
                                        <strong>Cancelled:</strong> @Model.CancelledAt.Value.ToString("MMM dd, yyyy hh:mm tt")
                                    </p>
                                }
                            </div>
                            <div class="col-md-6">
                                @if (!string.IsNullOrEmpty(Model.StripePaymentIntentId))
                                {
                                    <p class="mb-2">
                                        <strong>Payment ID:</strong><br />
                                        <small class="text-muted">@Model.StripePaymentIntentId</small>
                                    </p>
                                }
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Participants -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5><i class="fas fa-user"></i> @(Model.IsBuyer ? "Seller" : "Buyer")</h5>
                            @if (Model.IsBuyer)
                            {
                                <p class="mb-1"><strong>@Model.SellerName</strong></p>
                                <p class="mb-1 text-muted">
                                    <i class="fas fa-envelope"></i> @Model.SellerEmail
                                </p>
                            }
                            else
                            {
                                <p class="mb-1"><strong>@Model.BuyerName</strong></p>
                                <p class="mb-1 text-muted">
                                    <i class="fas fa-envelope"></i> @Model.BuyerEmail
                                </p>
                            }
                        </div>
                        <div class="col-md-6">
                            <h5><i class="fas fa-map-marker-alt"></i> Pickup Location</h5>
                            <address class="mb-0">
                                @Model.PickupAddressLine1<br />
                                @if (!string.IsNullOrEmpty(Model.PickupAddressLine2))
                                {
                                    @Model.PickupAddressLine2<br />
                                }
                                @Model.PickupCity, @Model.PickupState @Model.PickupZipCode
                            </address>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions Panel -->
        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-tasks"></i> Actions</h5>
                </div>
                <div class="card-body">
                    @if (Model.Status == ShareApp.Web.Entities.TransactionStatus.Pending)
                    {
                        @if (Model.IsBuyer && Model.TransactionType == ShareApp.Web.Entities.TransactionType.Purchase)
                        {
                            <div class="alert alert-info mb-3">
                                <i class="fas fa-credit-card"></i>
                                <strong>Payment Required</strong>
                                <p class="mb-0 small">Complete payment to finalize this transaction.</p>
                            </div>

                            <div class="d-grid gap-2 mb-2">
                                <button type="button" class="btn btn-success" onclick="showPaymentModal(@Model.Id, @Model.Amount.GetValueOrDefault())">
                                    <i class="fas fa-credit-card"></i> Pay Now
                                </button>
                            </div>
                        }

                        @if (Model.IsSeller)
                        {
                            <div class="alert alert-info mb-3">
                                <i class="fas fa-info-circle"></i>
                                <strong>Pending Pickup</strong>
                                <p class="mb-0 small">Mark as completed once the buyer picks up the item.</p>
                            </div>

                            <form asp-action="Complete" method="post" class="mb-2">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-success" onclick="return confirm('Mark this transaction as completed?')">
                                        <i class="fas fa-check"></i> Mark Completed
                                    </button>
                                </div>
                            </form>
                        }

                        @if (Model.CanCancel)
                        {
                            <form asp-action="Cancel" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Cancel this transaction?')">
                                        <i class="fas fa-times"></i> Cancel Request
                                    </button>
                                </div>
                            </form>
                        }
                    }
                    else if (Model.Status == ShareApp.Web.Entities.TransactionStatus.Completed)
                    {
                        <div class="alert alert-success mb-3">
                            <i class="fas fa-check-circle"></i>
                            <strong>Completed</strong>
                            <p class="mb-0 small">This transaction has been completed successfully.</p>
                        </div>

                        @if (Model.IsBuyer || Model.IsSeller)
                        {
                            <div class="d-grid gap-2">
                                <a asp-controller="Reviews" asp-action="Create" asp-route-transactionId="@Model.Id" class="btn btn-outline-primary">
                                    <i class="fas fa-star"></i> Leave Review
                                </a>
                            </div>
                        }
                    }
                    else if (Model.Status == ShareApp.Web.Entities.TransactionStatus.Cancelled)
                    {
                        <div class="alert alert-secondary mb-3">
                            <i class="fas fa-ban"></i>
                            <strong>Cancelled</strong>
                            <p class="mb-0 small">This transaction has been cancelled.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Help Card -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-question-circle"></i> Need Help?</h5>
                </div>
                <div class="card-body">
                    <p class="small mb-2">
                        If you have any issues with this transaction, please contact us.
                    </p>
                    <div class="d-grid">
                        <button class="btn btn-sm btn-outline-secondary" disabled>
                            <i class="fas fa-envelope"></i> Contact Support (Coming Soon)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="paymentModalLabel">
                    <i class="fas fa-credit-card"></i> Complete Payment
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="transactionId" value="@Model.Id" />

                <div class="alert alert-info mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span><strong>Amount:</strong></span>
                        <span class="h5 mb-0" id="payment-amount-display">$@Model.Amount.GetValueOrDefault().ToString("F2")</span>
                    </div>
                </div>

                <!-- Loading State -->
                <div id="payment-loading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Initializing payment...</p>
                </div>

                <!-- Payment Form -->
                <div id="payment-form-container" style="display: none;">
                    <form id="payment-form">
                        <!-- Stripe Payment Element will be inserted here -->
                        <div id="payment-element"></div>

                        <!-- Error Message -->
                        <div id="payment-error" class="alert alert-danger mt-3" style="display: none;"></div>

                        <!-- Submit Button -->
                        <button type="submit" id="payment-submit" class="btn btn-success w-100 mt-3">
                            <span id="payment-spinner" class="spinner-border spinner-border-sm me-2" style="display: none;"></span>
                            <span id="payment-button-text">Pay Now</span>
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-sm btn-link text-muted" data-bs-dismiss="modal">Cancel</button>
                    </div>

                    <div class="mt-3 text-center">
                        <small class="text-muted">
                            <i class="fas fa-lock"></i> Secure payment powered by Stripe
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        var stripePublishableKey = Configuration["Stripe:PublishableKey"];
    }
    @inject Microsoft.Extensions.Configuration.IConfiguration Configuration

    @if (!string.IsNullOrEmpty(stripePublishableKey) && stripePublishableKey != "pk_test_...")
    {
        <script src="https://js.stripe.com/v3/"></script>
        <script>
            // Initialize Stripe with publishable key
            initializeStripe('@stripePublishableKey');
        </script>
    }
    else
    {
        <script>
            // Stripe not configured - show error
            function showPaymentModal() {
                alert('Stripe payment integration is not configured. Please add your Stripe publishable key to appsettings.json');
            }
        </script>
    }

    <script src="~/js/payment.js"></script>

    @if (!string.IsNullOrEmpty(stripePublishableKey) && stripePublishableKey != "pk_test_...")
    {
        <script>
            // Handle payment form submission
            document.getElementById('payment-form')?.addEventListener('submit', handlePaymentSubmit);
        </script>
    }
}
