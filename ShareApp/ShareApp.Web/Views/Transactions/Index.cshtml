@model ShareApp.Web.Models.ViewModels.TransactionListViewModel

@{
    ViewData["Title"] = "My Transactions";
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="fas fa-exchange-alt"></i> My Transactions
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <ul class="nav nav-tabs mb-4" id="transactionTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="purchases-tab" data-bs-toggle="tab" data-bs-target="#purchases" type="button">
                <i class="fas fa-shopping-bag"></i> My Purchases (@Model.Purchases.Count())
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="sales-tab" data-bs-toggle="tab" data-bs-target="#sales" type="button">
                <i class="fas fa-hand-holding-usd"></i> My Sales (@Model.Sales.Count())
            </button>
        </li>
    </ul>

    <div class="tab-content" id="transactionTabsContent">
        <!-- Purchases Tab -->
        <div class="tab-pane fade show active" id="purchases" role="tabpanel">
            @if (!Model.Purchases.Any())
            {
                <div class="alert alert-info text-center py-5">
                    <i class="fas fa-shopping-bag fa-3x mb-3"></i>
                    <h4>No Purchases Yet</h4>
                    <p>You haven't requested or purchased any items yet.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                        <i class="fas fa-search"></i> Browse Items
                    </a>
                </div>
            }
            else
            {
                <div class="row row-cols-1 g-3">
                    @foreach (var transaction in Model.Purchases)
                    {
                        <div class="col">
                            <div class="card shadow-sm">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-2">
                                            @if (!string.IsNullOrEmpty(transaction.ItemImageUrl))
                                            {
                                                <img src="@transaction.ItemImageUrl" class="img-fluid rounded" alt="@transaction.ItemTitle" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 80px;">
                                                    <i class="fas fa-image fa-2x text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="col-md-7">
                                            <h5 class="mb-2">@transaction.ItemTitle</h5>
                                            <p class="text-muted mb-1">
                                                <i class="fas fa-user"></i> Seller: @transaction.SellerName
                                            </p>
                                            <p class="text-muted mb-1">
                                                <i class="fas fa-calendar"></i> @transaction.CreatedAt.ToString("MMM dd, yyyy")
                                            </p>
                                            @if (transaction.TransactionType == ShareApp.Web.Entities.TransactionType.Purchase && transaction.Amount.HasValue)
                                            {
                                                <p class="mb-0">
                                                    <strong class="text-success">$@transaction.Amount.Value.ToString("F2")</strong>
                                                </p>
                                            }
                                            else if (transaction.TransactionType == ShareApp.Web.Entities.TransactionType.FreePickup)
                                            {
                                                <p class="mb-0">
                                                    <strong class="text-primary">FREE</strong>
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="mb-0">
                                                    <strong class="text-info">BARTER</strong>
                                                </p>
                                            }
                                        </div>
                                        <div class="col-md-3 text-end">
                                            <span class="badge bg-@(transaction.Status == ShareApp.Web.Entities.TransactionStatus.Completed ? "success" : transaction.Status == ShareApp.Web.Entities.TransactionStatus.Pending ? "warning" : "secondary") mb-2">
                                                @transaction.Status
                                            </span>
                                            <div class="d-grid">
                                                <a asp-action="Details" asp-route-id="@transaction.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i> View Details
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Sales Tab -->
        <div class="tab-pane fade" id="sales" role="tabpanel">
            @if (!Model.Sales.Any())
            {
                <div class="alert alert-info text-center py-5">
                    <i class="fas fa-hand-holding-usd fa-3x mb-3"></i>
                    <h4>No Sales Yet</h4>
                    <p>You haven't received any requests for your items yet.</p>
                    <a asp-controller="Items" asp-action="Create" class="btn btn-primary mt-3">
                        <i class="fas fa-plus-circle"></i> List New Item
                    </a>
                </div>
            }
            else
            {
                <div class="row row-cols-1 g-3">
                    @foreach (var transaction in Model.Sales)
                    {
                        <div class="col">
                            <div class="card shadow-sm">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-2">
                                            @if (!string.IsNullOrEmpty(transaction.ItemImageUrl))
                                            {
                                                <img src="@transaction.ItemImageUrl" class="img-fluid rounded" alt="@transaction.ItemTitle" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 80px;">
                                                    <i class="fas fa-image fa-2x text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="col-md-7">
                                            <h5 class="mb-2">@transaction.ItemTitle</h5>
                                            <p class="text-muted mb-1">
                                                <i class="fas fa-user"></i> Buyer: @transaction.BuyerName
                                            </p>
                                            <p class="text-muted mb-1">
                                                <i class="fas fa-calendar"></i> @transaction.CreatedAt.ToString("MMM dd, yyyy")
                                            </p>
                                            @if (transaction.TransactionType == ShareApp.Web.Entities.TransactionType.Purchase && transaction.Amount.HasValue)
                                            {
                                                <p class="mb-0">
                                                    <strong class="text-success">$@transaction.Amount.Value.ToString("F2")</strong>
                                                </p>
                                            }
                                            else if (transaction.TransactionType == ShareApp.Web.Entities.TransactionType.FreePickup)
                                            {
                                                <p class="mb-0">
                                                    <strong class="text-primary">FREE</strong>
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="mb-0">
                                                    <strong class="text-info">BARTER</strong>
                                                </p>
                                            }
                                        </div>
                                        <div class="col-md-3 text-end">
                                            <span class="badge bg-@(transaction.Status == ShareApp.Web.Entities.TransactionStatus.Completed ? "success" : transaction.Status == ShareApp.Web.Entities.TransactionStatus.Pending ? "warning" : "secondary") mb-2">
                                                @transaction.Status
                                            </span>
                                            <div class="d-grid">
                                                <a asp-action="Details" asp-route-id="@transaction.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i> View Details
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
